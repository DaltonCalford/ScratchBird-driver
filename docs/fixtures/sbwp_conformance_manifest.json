{
  "schema_version": "1.0",
  "protocol_version": "sbwp-1.1",
  "suite": "sbwp-v1.1-native-parser-minimal",
  "fixtures": [
    "core_fixture.sql",
    "types_fixture.sql"
  ],
  "requires": ["tls", "auth", "native_parser", "prepare_bind", "types"],
  "tests": [
    {
      "id": "handshake",
      "kind": "native_query",
      "sql": "SELECT 1",
      "expect_rows": 1
    },
    {
      "id": "auth",
      "kind": "auth"
    },
    {
      "id": "prepare_bind",
      "kind": "native_prepare_bind",
      "sql": "SELECT $1::INTEGER",
      "params": [42],
      "expect_rows": 1
    },
    {
      "id": "describe_param_mismatch",
      "kind": "native_prepare_bind",
      "sql": "SELECT $1::INTEGER, $2::INTEGER",
      "params": [1],
      "expect_sqlstate": "07001"
    },
    {
      "id": "types_one_way",
      "kind": "native_query",
      "sql": "SELECT * FROM users.public.type_coverage",
      "expect_rows": 1
    },
    {
      "id": "paging_basic_table",
      "kind": "native_query",
      "sql": "SELECT id FROM users.public.basic_table ORDER BY id",
      "expect_rows": 6,
      "dsn_append": "fetch_size=1"
    },
    {
      "id": "cancel_stream",
      "kind": "cancel",
      "sql": "SELECT a.id FROM users.public.basic_table a, users.public.basic_table b, users.public.basic_table c, users.public.basic_table d, users.public.basic_table e",
      "cancel_after_rows": 1,
      "expect_sqlstate": "57014",
      "dsn_append": "fetch_size=1",
      "requires": ["cancel"]
    }
  ]
}
